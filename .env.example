# NASA FIRMS MAP_KEY - required for the karhutla (wildfire) layer.
# Free, register at: https://firms.modaps.eosdis.nasa.gov/api/map_key/
FIRMS_MAP_KEY=

# ReliefWeb appname - required for the ReliefWeb "verified source" layer
# under /api/lainnya. As of Nov 2025, ReliefWeb requires a pre-approved
# appname (arbitrary strings are rejected with HTTP 403). Request one at:
# https://apidoc.reliefweb.int/parameters#appname
# Optional: /api/lainnya degrades gracefully (GDACS only) if unset.
RELIEFWEB_APPNAME=
